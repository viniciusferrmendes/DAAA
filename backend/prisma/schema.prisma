generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccidentStatus {
  draft
  awaiting_other_party
  both_in_draft
  ready_to_sign
  signed_by_one
  signed_by_both
  pdf_generated
  submitted
}

enum PartyRole {
  A
  B
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  contact      String?
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicles      Vehicle[]
  auditLogs     AuditLog[]
  Accident      Accident[]
  AccidentParty AccidentParty[]
}

model Vehicle {
  id      Int    @id @default(autoincrement())
  brand   String
  model   String
  plate   String
  country String
  year    Int

  insuranceCompany   String?
  insurancePolicyNum String?
  insuranceStart     DateTime?
  insuranceEnd       DateTime?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Accident {
  id              Int            @id @default(autoincrement())
  dateTime        DateTime?
  address         String?
  country         String?
  geoLat          Float?
  geoLng          Float?
  injuries        Boolean        @default(false)
  materialDamages Json?
  witnessesA      Json?
  witnessesB      Json?
  circumstances   Json?
  collisionPoint  Json?
  visibleDamages  Json?
  sketchUrl       String?
  observations    Json?
  signatures      Json?
  status          AccidentStatus @default(draft)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy Int
  creator   User @relation(fields: [createdBy], references: [id])

  parties    AccidentParty[]
  qrSessions QrSession[]
  auditLogs  AuditLog[]

  @@index([status])
  @@index([createdBy])
}

model AccidentParty {
  id         Int       @id @default(autoincrement())
  accidentId Int
  role       PartyRole

  insured   Json?
  vehicle   Json?
  insurance Json?
  driver    Json?

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accident Accident @relation(fields: [accidentId], references: [id])

  @@unique([accidentId, role])
  @@index([accidentId])
  @@index([userId])
}

model QrSession {
  id         Int      @id @default(autoincrement())
  accidentId Int
  token      String   @unique
  expiresAt  DateTime
  used       Boolean  @default(false)

  createdAt DateTime @default(now())

  accident Accident @relation(fields: [accidentId], references: [id])

  @@index([accidentId])
  @@index([expiresAt])
}

enum AuditAction {
  CREATE_ACCIDENT
  UPDATE_GENERAL
  UPDATE_PARTYA
  UPDATE_PARTYB
  UPDATE_CIRCUMSTANCES
  UPDATE_COLLISION_POINT
  UPDATE_VISIBLE_DAMAGES
  UPDATE_WITNESSES
  UPDATE_OBSERVATIONS
  UPDATE_SIGNATURES
  UPDATE_SKETCH
  SIGN_PARTYA
  SIGN_PARTYB
  PDF_GENERATED
  FINALIZED
}

model AuditLog {
  id         Int         @id @default(autoincrement())
  accidentId Int?
  userId     Int?
  party      PartyRole?
  action     AuditAction
  ip         String?
  geoLat     Float?
  geoLng     Float?
  ts         DateTime    @default(now())

  user     User?     @relation(fields: [userId], references: [id])
  accident Accident? @relation(fields: [accidentId], references: [id])

  @@index([accidentId])
  @@index([userId])
  @@index([ts])
}
